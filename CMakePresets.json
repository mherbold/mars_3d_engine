{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 28,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "windows-x64-debug",
            "displayName": "Windows x64 Debug",
            "description": "Debug configuration for Windows x64 using MSVC (Visual Studio 2026)",
            "generator": "Visual Studio 18 2026",
            "architecture": {
                "value": "x64",
                "strategy": "set"
            },
            "binaryDir": "C:/mars_build/debug",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "C:/mars_build/install/debug",
                "FETCHCONTENT_BASE_DIR": "C:/mars_build/fetchcontent",
                "MARS_ENABLE_DEV_UI": "ON"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "windows-x64-release",
            "displayName": "Windows x64 Release",
            "description": "Release configuration for Windows x64 using MSVC (Visual Studio 2026)",
            "generator": "Visual Studio 18 2026",
            "architecture": {
                "value": "x64",
                "strategy": "set"
            },
            "binaryDir": "C:/mars_build/release",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "C:/mars_build/install/release",
                "FETCHCONTENT_BASE_DIR": "C:/mars_build/fetchcontent",
                "MARS_ENABLE_DEV_UI": "OFF"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "windows-x64-debug-build",
            "displayName": "Build Windows x64 Debug",
            "configurePreset": "windows-x64-debug",
            "configuration": "Debug"
        },
        {
            "name": "windows-x64-release-build",
            "displayName": "Build Windows x64 Release",
            "configurePreset": "windows-x64-release",
            "configuration": "Release"
        }
    ],
    "testPresets": [
        {
            "name": "windows-x64-debug-test",
            "displayName": "Test Windows x64 Debug",
            "configurePreset": "windows-x64-debug",
            "configuration": "Debug"
        },
        {
            "name": "windows-x64-release-test",
            "displayName": "Test Windows x64 Release",
            "configurePreset": "windows-x64-release",
            "configuration": "Release"
        }
    ]
}
